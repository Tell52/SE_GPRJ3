{
  "name": "event-planner",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "server", "e2e"],
  "engines": { "node": "^20.19.0 || ^22.12.0 || >=24.0.0" },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm test --workspace server && npm test --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm start --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run seed --workspace server"
  }
}
